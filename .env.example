# Token du bot (portail développeur Discord > Bot)
DISCORD_TOKEN=
# ID de l'application (utilisé uniquement par npm run deploy)
CLIENT_ID=
# (Optionnel) ID du serveur pour un enregistrement instantané des commandes
GUILD_ID=
# API pixelauto (commande /video) : URL de base et clé envoyée dans X-API-Key
PIXELAUTO_URL=
API_KEY=
